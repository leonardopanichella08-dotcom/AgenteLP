# ─────────────────────────────────────────────────────────────
#  LUKA — configurazione.  Copia in .env e compila.
#  L'APP FUNZIONA ANCHE SENZA NESSUNA CHIAVE (demo mode).
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Default: SQLite locale (nessun setup).
# Produzione (Vercel): connection string di Neon.
#   DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./luka.db

# ── LLM (opzionale) ──────────────────────────────────────────
# Assente  => Luka genera in "demo mode" (template).
# Presente => generazione e onboarding con Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Discovery post virali ────────────────────────────────────
# "sample" = dataset locale incluso (gratis, zero setup).
# "apify"  = scraping reale (richiede APIFY_TOKEN, consuma crediti).
DISCOVERY_PROVIDER=sample
APIFY_TOKEN=
APIFY_ACTOR=apimaestro/linkedin-posts-search-scraper-no-cookies

# ── LinkedIn OAuth (opzionale) ───────────────────────────────
# App su https://www.linkedin.com/developers/ con prodotto
# "Sign In with LinkedIn using OpenID Connect".
# Il redirect URI qui sotto va inserito IDENTICO nella config dell'app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/api/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile email
FRONTEND_URL=http://localhost:5173

# ── Sicurezza ────────────────────────────────────────────────
# Chiave Fernet per cifrare i token LinkedIn a riposo.
# Generane una nuova con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────
# "*" in sviluppo; in produzione l'URL del frontend.
CORS_ORIGINS=*
